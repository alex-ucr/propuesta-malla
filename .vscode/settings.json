    "jupyter.kernels.trusted": [
        "c:\\ProgramData\\jupyter\\kernels\\ir\\kernel.json"
    ],
    "[python]": {
        "editor.formatOnType": true
    },
    "python.defaultInterpreterPath": "C:\\Users\\josea\\AppData\\Local\\Programs\\Python\\Python311\\python.exe",
    "window.zoomLevel": 2,
    "terminal.integrated.defaultProfile.windows": "Command Prompt",
    "git.path": "C:\\Users\\josea\\AppData\\Local\\Atlassian\\SourceTree\\git_local\\cmd\\git.exe",
    "terminal.integrated.commandsToSkipShell": [
        "language-julia.interrupt"
    ],
    "julia.symbolCacheDownload": true,
    "julia.enableTelemetry": true,
    "files.autoGuessEncoding": true,
    "launch": {
        "configurations": [
            

        ]
    },
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "editor.scrollbar.scrollByPage": true,
    "workbench.list.scrollByPage": true,
    "hediet.vscode-drawio.resizeImages": null,
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": ["--output-directory=%OUTDIR%","%DOCFILE%"]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "pdflatex -> biber -> pdflatex*2",
            "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
        }
    ],
    "latex-workshop.latex.autoClean.run": "never",
